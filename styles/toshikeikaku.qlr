    <layer-tree-layer id="kousoujyukyo_layer" name="高層住居誘導地区" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="tokureiyouseki_layer" name="特例容積率適用地区" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
