<!DOCTYPE qgis-layer-definition>
<!-- 都市計画決定GISデータ（全国）: GeoParquet 26テーマのレイヤ定義。
     https://github.com/shiwaku/mlit-urban-planning-converter が生成。
     *.parquet と同じフォルダに置いてから QGIS にドラッグ&ドロップすること。 -->
<qlr>
  <layer-tree-group>
    <layer-tree-layer id="douro_layer" name="都市計画道路" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="fukkousaiseikyoten_layer" name="一団地の復興再生拠点市街地形成施設" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="soubou_layer" name="航空機騒音障害防止地区" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="kouen_layer" name="公園" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="tochiku_layer" name="土地区画整理事業" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="chikukei_layer" name="地区計画" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="toshisaisei_layer" name="都市再生特別地区" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="rekifuu_layer" name="歴史的風土保存地区" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="tokuryoku_layer" name="特別緑地保全地区" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="ryokukachiiki_layer" name="緑化地域" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="fuuchichiku_layer" name="風致地区" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="tokuteibou_layer" name="特定防災街区整備地区" source="" providerKey="" checked="Qt::Unchecked" expanded="0">
      <customproperties/>
